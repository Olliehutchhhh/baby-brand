{%- comment -%} One option in the sticky bar's product dropdown. Choosing it opens that product's page (pre-loaded in the background so the switch is near-instant). {%- endcomment -%}
{%- if p != blank -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  {%- if p.id == cur_id -%}{%- assign v = cur_variant -%}{%- endif -%}
  <option value="{{ p.url }}"{% if p.id == cur_id %} selected{% endif %}>{{ label | escape }} &middot; {{ v.price | money }}</option>
{%- endif -%}
