{{ 'casa-features.css' | asset_url | stylesheet_tag }}
<section class="casa-kpf casa-steps">
  {%- if section.settings.heading != blank -%}<h2 class="casa-kpf__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="casa-kpf__grid">
    {%- for block in section.blocks -%}
      <div class="casa-kpf__card" {{ block.shopify_attributes }}>
        <div class="casa-kpf__img">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 33vw, 80vw', alt: block.settings.title }}
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="800">
          {%- endif -%}
        </div>
        <h3><span class="casa-kpf__num">{{ forloop.index }}</span>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (leave empty for a placeholder)" },
        { "type": "text", "id": "asset_image", "label": "Theme file name (used when no image is picked)", "info": "e.g. casa-warmer-step-1.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this step." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "How it works" } ]
}
{% endschema %}
