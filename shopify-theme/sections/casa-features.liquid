{{ 'casa-features.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign all_blocks = section.blocks | where: 'type', 'feature'
  assign has_labels = false
  if s.group_1_label != blank or s.group_2_label != blank
    assign has_labels = true
  endif
-%}

{%- if all_blocks.size > 0 -%}
<section class="casa-kpf" id="keyFeatures-{{ section.id }}">
  {%- if s.heading != blank -%}<h2 class="casa-kpf__title">{{ s.heading | escape }}</h2>{%- endif -%}
  {%- for g in (1..2) -%}
    {%- liquid
      assign g_s = g | append: ''
      assign group_count = 0
      for block in all_blocks
        if block.settings.row == g_s
          assign group_count = group_count | plus: 1
        endif
      endfor
      if g == 1
        assign label = s.group_1_label
      else
        assign label = s.group_2_label
      endif
    -%}
    {%- if group_count > 0 -%}
      <div class="casa-kpf__group">
        {%- if label != blank -%}<h3 class="casa-kpf__label">{{ label | escape }}</h3>{%- endif -%}
        <div class="casa-kpf__grid">
          {%- for block in all_blocks -%}
            {%- if block.settings.row == g_s -%}
              <div class="casa-kpf__card" {{ block.shopify_attributes }}>
                <div class="casa-kpf__img">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 33vw, 80vw', alt: block.settings.title }}
                  {%- elsif block.settings.asset_image != blank -%}
                    <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="800">
                  {%- endif -%}
                </div>
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Key product features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key Product Features" },
    { "type": "text", "id": "group_1_label", "label": "Top row label", "info": "Optional. Leave empty on single-product pages." },
    { "type": "text", "id": "group_2_label", "label": "Bottom row label", "info": "Optional. Used on the bundle page (e.g. Cooler)." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (leave empty for a placeholder)" },
        { "type": "text", "id": "asset_image", "label": "Theme file name (used when no image is picked)", "info": "e.g. casa-warmer-feature-1.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this feature." },
        { "type": "select", "id": "row", "label": "Row", "options": [ { "value": "1", "label": "Top row" }, { "value": "2", "label": "Bottom row" } ], "default": "1" }
      ]
    }
  ],
  "presets": [ { "name": "Key product features" } ]
}
{% endschema %}
