{{ 'casa-features.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign warmer_p = blank
  assign cooler_p = blank
  assign bundle_p = blank
  for p in collections['all'].products
    case p.template_suffix
      when 'casa-warmer'
        assign warmer_p = p
      when 'casa-cooler'
        assign cooler_p = p
      when 'casa-bundle'
        assign bundle_p = p
    endcase
  endfor
  assign cur = product.template_suffix
  assign pct = 0
  assign w_pr = warmer_p.selected_or_first_available_variant.price | default: 0
  assign c_pr = cooler_p.selected_or_first_available_variant.price | default: 0
  assign b_pr = bundle_p.selected_or_first_available_variant.price | default: 0
  assign sum_pr = w_pr | plus: c_pr
  if sum_pr > b_pr and b_pr > 0
    assign pct = sum_pr | minus: b_pr | times: 100.0 | divided_by: sum_pr | round
  endif
-%}
<section class="casa-kpf casa-sets">
  {%- if s.heading != blank -%}<h2 class="casa-kpf__title">{{ s.heading | escape }}</h2>{%- endif -%}
  <div class="casa-kpf__grid">
    {%- for n in (1..3) -%}
      {%- liquid
        if n == 1
          assign p = warmer_p
          assign suffix = 'casa-warmer'
          assign name = s.warmer_name
          assign bullets = s.warmer_bullets
        elsif n == 2
          assign p = cooler_p
          assign suffix = 'casa-cooler'
          assign name = s.cooler_name
          assign bullets = s.cooler_bullets
        else
          assign p = bundle_p
          assign suffix = 'casa-bundle'
          assign name = s.bundle_name
          assign bullets = s.bundle_bullets
        endif
        assign bullet_list = bullets | newline_to_br | split: '<br />'
      -%}
      {%- if p != blank -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <div class="casa-kpf__card casa-set{% if n == 3 %} casa-set--best{% endif %}">
          {%- if n == 3 -%}<span class="casa-set__ribbon">{{ s.best_label | escape }}</span>{%- endif -%}
          <div class="casa-set__img">
            {%- if p.featured_media != blank -%}{{ p.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 30vw, 70vw', alt: name }}{%- endif -%}
          </div>
          <h3>{{ name | escape }}</h3>
          <ul>
            {%- for b in bullet_list -%}
              {%- assign bt = b | strip -%}
              {%- if bt contains '[percent]' -%}
                {%- if pct > 0 -%}<li>{{ bt | replace: '[percent]', pct | escape }}</li>{%- endif -%}
              {%- elsif bt != blank -%}<li>{{ bt | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="casa-set__price">
            {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}{{ v.price | money }}
          </div>
          {%- if cur == suffix -%}
            <div class="casa-set__here">{{ s.here_label | escape }}</div>
          {%- else -%}
            <a class="casa-set__btn" href="{{ p.url }}">View {{ name | downcase | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Choose your set",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your set" },
    { "type": "text", "id": "warmer_name", "label": "Warmer name", "default": "Portable Warmer" },
    { "type": "textarea", "id": "warmer_bullets", "label": "Warmer bullet points (one per line)", "default": "Warms milk and water\nHeats fast\nLong battery life" },
    { "type": "text", "id": "cooler_name", "label": "Cooler name", "default": "Portable Cooler" },
    { "type": "textarea", "id": "cooler_bullets", "label": "Cooler bullet points (one per line)", "default": "Iceless 360° cooling\nCold for up to 24 hours\n650ml, fits two 300ml bottles" },
    { "type": "text", "id": "bundle_name", "label": "Bundle name", "default": "Warmer & Cooler Set" },
    { "type": "textarea", "id": "bundle_bullets", "label": "Bundle bullet points (one per line)", "info": "Use [percent] to show the saving automatically.", "default": "Portable warmer + portable cooler\nSave [percent]% vs buying separately\nFree E-Book worth £10" },
    { "type": "text", "id": "best_label", "label": "Bundle label", "default": "BEST VALUE" },
    { "type": "text", "id": "here_label", "label": "Label on the current product", "default": "You’re viewing this" }
  ],
  "presets": [ { "name": "Choose your set" } ]
}
{% endschema %}
