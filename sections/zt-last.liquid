<div></div>
{% schema %}
{
 "name": "Casa product page",
 "tag": "section",
 "enabled_on": {
  "templates": [
   "product"
  ]
 },
 "settings": [
  {
   "type": "textarea",
   "id": "bundle_list",
   "label": "Tick list (one per line)"
  },
  {
   "type": "text",
   "id": "gift_title",
   "label": "Strip heading",
   "default": "Your bundle"
  },
  {
   "type": "text",
   "id": "gift_name_1",
   "label": "Item 1 name",
   "default": "Warmer"
  },
  {
   "type": "image_picker",
   "id": "gift_image_1",
   "label": "Item 1 image (optional, default included)"
  },
  {
   "type": "text",
   "id": "gift_name_2",
   "label": "Item 2 name",
   "default": "Breast Milk Cooler"
  },
  {
   "type": "image_picker",
   "id": "gift_image_2",
   "label": "Item 2 image (optional, default included)"
  },
  {
   "type": "header",
   "content": "Reviews"
  },
  {
   "type": "text",
   "id": "reviews_title",
   "label": "Heading",
   "default": "What Other Parents Are Saying"
  },
  {
   "type": "text",
   "id": "sample_review_prefix",
   "label": "Built-in review photo file prefix",
   "default": "casa-review-",
   "info": "Files are named prefix1.jpg to prefix5.jpg in the theme assets."
  },
  {
   "type": "range",
   "id": "sample_review_count",
   "label": "Number of built-in review photos",
   "min": 1,
   "max": 5,
   "step": 1,
   "default": 5
  },
  {
   "type": "checkbox",
   "id": "use_sample_reviews",
   "label": "Use the five built-in review photos (when no review blocks are added)",
   "default": false
  },
  {
   "type": "header",
   "content": "Bundle quick-add box"
  },
  {
   "type": "text",
   "id": "bundle_box_text",
   "label": "Text",
   "default": "Save [percent]% on the bundle",
   "info": "[percent] is replaced with the real bundle saving."
  },
  {
   "type": "text",
   "id": "bundle_box_text_no_saving",
   "label": "Text when there is no saving",
   "default": "Get the complete bundle"
  },
  {
   "type": "text",
   "id": "bundle_box_button",
   "label": "Button label",
   "default": "Add bundle"
  },
  {
   "type": "header",
   "content": "Shipping and guarantee"
  },
  {
   "type": "text",
   "id": "shipping_label",
   "label": "Shipping label",
   "default": "FREE OVER £100"
  },
  {
   "type": "range",
   "id": "delivery_days",
   "label": "Delivery estimate (days from today)",
   "min": 1,
   "max": 21,
   "step": 1,
   "default": 7
  },
  {
   "type": "text",
   "id": "guarantee_title",
   "label": "Guarantee title",
   "default": "30 Days Guarantee"
  },
  {
   "type": "textarea",
   "id": "guarantee_body",
   "label": "Guarantee text",
   "default": "We stand behind our products. If you don't love it, exchanges and returns are available in 30 days."
  },
  {
   "type": "header",
   "content": "Pair well with"
  },
  {
   "type": "product",
   "id": "pair_product",
   "label": "Override: product to pair (leave empty — found automatically)"
  },
  {
   "type": "image_picker",
   "id": "pair_image",
   "label": "Image (optional, defaults to the product's first image)"
  },
  {
   "type": "text",
   "id": "pair_note",
   "label": "Note",
   "default": "Bundle discount"
  }
 ],
 "blocks": [
  {
   "type": "pill",
   "name": "Benefit pill",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "Benefit"
    }
   ]
  },
  {
   "type": "review",
   "name": "Review photo",
   "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "Photo (leave empty for a placeholder)"
    }
   ]
  }
 ]
}
{% endschema %}
