<div></div>
{% schema %}
{
 "name": "Casa product page",
 "tag": "section",
 "enabled_on": {
  "templates": [
   "product"
  ]
 },
 "settings": [
  {
   "type": "header",
   "content": "Page type"
  },
  {
   "type": "select",
   "id": "mode",
   "label": "This page is for",
   "default": "single",
   "options": [
    {
     "value": "single",
     "label": "A single product (warmer or cooler)"
    },
    {
     "value": "bundle",
     "label": "The bundle product"
    }
   ]
  },
  {
   "type": "product",
   "id": "bundle_product",
   "label": "Override: Bundle product (leave empty — found automatically)"
  },
  {
   "type": "product",
   "id": "single_product",
   "label": "Override: Single product (leave empty — found automatically)"
  },
  {
   "type": "header",
   "content": "Top of page"
  },
  {
   "type": "text",
   "id": "subtitle",
   "label": "Subtitle"
  },
  {
   "type": "text",
   "id": "social_proof",
   "label": "Social proof line (shown under the title when there is no review count)",
   "default": "Loved by busy parents"
  },
  {
   "type": "text",
   "id": "rating_count",
   "label": "Review count (shown as stars + number; leave blank to hide)"
  },
  {
   "type": "text",
   "id": "perk_text",
   "label": "Perk line under Add To Cart",
   "default": "Free Shipping on orders £100+"
  },
  {
   "type": "textarea",
   "id": "description",
   "label": "Description (leave blank to use the product's own description)"
  },
  {
   "type": "header",
   "content": "Left option card (single product)"
  },
  {
   "type": "text",
   "id": "single_title",
   "label": "Title",
   "default": "Portable Warmer"
  },
  {
   "type": "text",
   "id": "single_sub",
   "label": "Sub-heading",
   "default": "Just the warmer"
  },
  {
   "type": "textarea",
   "id": "single_list",
   "label": "Tick list (one per line)"
  },
  {
   "type": "text",
   "id": "single_hint",
   "label": "Hint link text (use [percent] for the automatic saving)",
   "default": "Add the cooler & save [percent]% ↓"
  },
  {
   "type": "header",
   "content": "Cooler link card (bundle page only)"
  },
  {
   "type": "text",
   "id": "cooler_title",
   "label": "Title",
   "default": "Portable Cooler"
  },
  {
   "type": "text",
   "id": "cooler_sub",
   "label": "Sub-heading",
   "default": "Just the cooler"
  },
  {
   "type": "textarea",
   "id": "cooler_list",
   "label": "Tick list (one per line)"
  },
  {
   "type": "header",
   "content": "Bundle And Save card"
  },
  {
   "type": "text",
   "id": "bundle_title",
   "label": "Title",
   "default": "Bundle And Save"
  },
  {
   "type": "text",
   "id": "bundle_ribbon",
   "label": "Ribbon",
   "default": "BEST VALUE"
  },
  {
   "type": "text",
   "id": "bundle_badge",
   "label": "Save badge (leave EMPTY for automatic saving %)"
  },
  {
   "type": "text",
   "id": "bundle_sub",
   "label": "Sub-heading",
   "default": "Warmer & Cooler Set"
  }
 ],
 "blocks": [
  {
   "type": "pill",
   "name": "Benefit pill",
   "settings": [
    {
     "type": "text",
     "id": "text",
     "label": "Text",
     "default": "Benefit"
    }
   ]
  },
  {
   "type": "review",
   "name": "Review photo",
   "settings": [
    {
     "type": "image_picker",
     "id": "image",
     "label": "Photo (leave empty for a placeholder)"
    }
   ]
  }
 ]
}
{% endschema %}
