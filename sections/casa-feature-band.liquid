{{ 'casa-features.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="casa-band">
  <div class="casa-band__in{% if s.image_right %} casa-band__in--flip{% endif %}">
    <div class="casa-band__img">
      {%- if s.image != blank -%}{{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.heading }}{%- elsif s.asset_image != blank -%}<img src="{{ s.asset_image | asset_url }}" alt="{{ s.heading | escape }}" loading="lazy" width="1000" height="1000">{%- endif -%}
    </div>
    <div class="casa-band__txt">
      <h2>{{ s.heading | escape }}</h2>
      <p>{{ s.text | escape }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (leave empty for a placeholder)" },
    { "type": "text", "id": "asset_image", "label": "Theme file name (used when no image is picked)", "info": "e.g. casa-warmer-banner.jpg" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feeding on the go, made easy." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell parents why this product makes life easier." },
    { "type": "checkbox", "id": "image_right", "label": "Show image on the right", "default": false }
  ],
  "presets": [ { "name": "Feature banner" } ]
}
{% endschema %}
