{% comment %} Auto-link: the other Casa products are found by the theme template each is assigned (casa-warmer / casa-cooler / casa-bundle), so no pickers need setting. Pickers in the section are optional overrides. Pair: bundle page -> cooler; warmer page -> cooler; cooler page -> warmer. {% endcomment %}
{{ 'casa-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'casa-product-form-' | append: section.id
  assign is_bundle = false
  if s.mode == 'bundle'
    assign is_bundle = true
  endif

  assign warmer_found = blank
  assign cooler_found = blank
  assign bundle_found = blank
  for p in collections['all'].products
    case p.template_suffix
      when 'casa-warmer'
        assign warmer_found = p
      when 'casa-cooler'
        assign cooler_found = p
      when 'casa-bundle'
        assign bundle_found = p
    endcase
  endfor

  assign bundle_p = s.bundle_product | default: bundle_found
  assign single_p = s.single_product | default: warmer_found

  assign auto_pair = cooler_found
  if is_bundle == false and product.id == cooler_found.id
    assign auto_pair = warmer_found
  endif
  assign pair_p_final = s.pair_product | default: auto_pair
  assign off_pct = 0
  if variant.compare_at_price > variant.price
    assign off_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif
  assign pills = section.blocks | where: 'type', 'pill'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign pdp_desc = s.description
  if pdp_desc == blank
    assign pdp_desc = product.description
  endif

  if s.gift_image_1 != blank
    assign gift_1 = s.gift_image_1 | image_url: width: 300
  else
    assign gift_1 = 'casa-gift-warmer.jpg' | asset_url
  endif
  if s.gift_image_2 != blank
    assign gift_2 = s.gift_image_2 | image_url: width: 300
  else
    assign gift_2 = 'casa-gift-cooler.jpg' | asset_url
  endif
  if s.gift_image_3 != blank
    assign gift_3 = s.gift_image_3 | image_url: width: 300
  else
    assign gift_3 = 'casa-gift-ebook.jpg' | asset_url
  endif
-%}

<div class="casa-pdp" id="casa-pdp-{{ section.id }}">

  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> &gt;
    {%- assign crumb_collection = collection | default: product.collections.first -%}
    {%- if crumb_collection != blank %} <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a> &gt;{% endif %}
    <span class="current">{{ product.title }}</span>
  </div>

  <main class="product">

    <!-- STICKY GALLERY -->
    <div class="gallery">
      {%- assign image_media = product.media | where: 'media_type', 'image' -%}
      <div class="thumb-strip" id="thumbsSingle">
        {%- for media in image_media -%}
          <button type="button" class="thumb has-img{% if forloop.first %} active{% endif %}" data-full="{{ media.preview_image | image_url: width: 1400 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}" style="background-image:url('{{ media.preview_image | image_url: width: 220 }}');background-size:cover;background-position:center;color:transparent;"></button>
        {%- endfor -%}
      </div>
      <div class="main-image-wrap" id="mainImage">
        <button type="button" class="gallery-arrow prev" aria-label="Previous image">&lsaquo;</button>
        {%- if product.featured_media != blank -%}
          <img id="mainImageImg" src="{{ product.featured_media.preview_image | image_url: width: 1400 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="900" height="900">
        {%- else -%}
          <img id="mainImageImg" alt="{{ product.title | escape }}" width="900" height="900">
        {%- endif -%}
        <button type="button" class="gallery-arrow next" aria-label="Next image">&rsaquo;</button>
        <button type="button" class="expand-btn" aria-label="Open image full size">&#10530;</button>
      </div>
    </div>

    <!-- SCROLLING INFO -->
    <div class="info">
      <h1 id="pdpTitle">{{ product.title }}</h1>
      {%- if s.subtitle != blank -%}<div class="subtitle" id="pdpSub">{{ s.subtitle }}</div>{%- endif -%}

      {%- if pills.size > 0 -%}
        <div class="benefit-pills" id="pdpPills">
          {%- for pill in pills -%}
            <div class="pill" {{ pill.shopify_attributes }}><span class="check">&#10003;</span> {{ pill.settings.text }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <hr class="section-divider">

      {%- if bundle_p != blank or single_p != blank or is_bundle -%}
      <div class="select-label">Select Option:</div>
      <div class="option-grid" aria-label="Choose your set">

        {%- comment -%} ===== LEFT: the single product ===== {%- endcomment -%}
        {%- assign left_tag = 'div' -%}
        {%- if is_bundle and single_p != blank -%}{%- assign left_tag = 'a' -%}{%- endif -%}
        <{{ left_tag }} class="opt-card{% unless is_bundle %} selected{% endunless %}"{% if left_tag == 'a' %} href="{{ single_p.url }}" style="text-decoration:none;color:inherit;"{% endif %}{% unless is_bundle %} aria-current="true"{% endunless %}>
          <div class="opt-head">
            <span class="opt-radio"></span>
            <span class="opt-title">{{ s.single_title }}</span>
          </div>
          {%- if is_bundle and single_p != blank -%}
            <div class="opt-price">{{ single_p.selected_or_first_available_variant.price | money }}</div>
          {%- else -%}
            <div class="opt-price">{{ variant.price | money }}</div>
          {%- endif -%}
          <div class="opt-sub">{{ s.single_sub }}</div>
          <ul class="opt-list">
            {%- assign lines = s.single_list | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- unless is_bundle -%}{%- if bundle_p != blank and s.single_hint != blank -%}<div class="opt-hint">{{ s.single_hint }}</div>{%- endif -%}{%- endunless -%}
        </{{ left_tag }}>

        {%- comment -%} ===== MIDDLE (bundle page only): link to the cooler on its own ===== {%- endcomment -%}
        {%- if is_bundle and pair_p_final != blank -%}
          {%- assign cooler_p = pair_p_final -%}
          <a class="opt-card" href="{{ cooler_p.url }}" style="text-decoration:none;color:inherit;">
            <div class="opt-head">
              <span class="opt-radio"></span>
              <span class="opt-title">{{ s.cooler_title }}</span>
            </div>
            <div class="opt-price">{{ cooler_p.selected_or_first_available_variant.price | money }}</div>
            <div class="opt-sub">{{ s.cooler_sub }}</div>
            <ul class="opt-list">
              {%- assign cooler_lines = s.cooler_list | newline_to_br | split: '<br />' -%}
              {%- for line in cooler_lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          </a>
        {%- endif -%}

        {%- comment -%} ===== RIGHT: Bundle And Save ===== {%- endcomment -%}
        {%- if is_bundle or bundle_p != blank -%}
          {%- assign right_tag = 'a' -%}
          {%- if is_bundle -%}{%- assign right_tag = 'div' -%}{%- endif -%}
          <{{ right_tag }} class="opt-card{% if is_bundle %} selected{% endif %}"{% unless is_bundle %} href="{{ bundle_p.url }}" style="text-decoration:none;color:inherit;"{% endunless %}{% if is_bundle %} aria-current="true"{% endif %}>
            {%- if s.bundle_ribbon != blank -%}<span class="opt-ribbon">{{ s.bundle_ribbon }}</span>{%- endif -%}
            <div class="opt-head">
              <span class="opt-radio"></span>
              <span class="opt-title">{{ s.bundle_title }}</span>
            </div>
            <div class="opt-price">
              {%- if is_bundle -%}{{ variant.price | money }}{%- else -%}{{ bundle_p.selected_or_first_available_variant.price | money }}{%- endif -%}
              {%- if s.bundle_badge != blank %} <span class="opt-save">{{ s.bundle_badge }}</span>{% endif -%}
            </div>
            <div class="opt-sub">{{ s.bundle_sub }}</div>
            <ul class="opt-list">
              {%- assign lines = s.bundle_list | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
            </ul>
            <div class="gift-strip">
              <div class="gift-title">{{ s.gift_title }}</div>
              <div class="gift-thumbs">
                <div class="gift-item"><div class="gift-img" role="img" aria-label="{{ s.gift_name_1 | escape }}" style="background:#fff url('{{ gift_1 }}') center/cover no-repeat;"></div><div class="gift-text"><div class="gift-name">{{ s.gift_name_1 }}</div></div></div>
                <span class="gift-plus" aria-hidden="true">+</span>
                <div class="gift-item"><div class="gift-img" role="img" aria-label="{{ s.gift_name_2 | escape }}" style="background:#fff url('{{ gift_2 }}') center/cover no-repeat;"></div><div class="gift-text"><div class="gift-name">{{ s.gift_name_2 }}</div></div></div>
                <span class="gift-plus" aria-hidden="true">+</span>
                <div class="gift-item"><div class="gift-img" role="img" aria-label="{{ s.gift_name_3 | escape }}" style="background:#fff url('{{ gift_3 }}') center/cover no-repeat;"></div><div class="gift-text"><div class="gift-name">{{ s.gift_name_3 }}</div>{%- if s.gift_3_was != blank -%}<div class="gift-was">{{ s.gift_3_was }}</div><div class="gift-free">FREE</div>{%- endif -%}</div></div>
              </div>
            </div>
          </{{ right_tag }}>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if s.rating_count != blank -%}
        <div class="rating">
          <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="review-count">({{ s.rating_count }})</span>
        </div>
      {%- endif -%}

      <div class="price-row">
        {%- if variant.compare_at_price > variant.price -%}<div class="price-old" id="casaPriceOld">{{ variant.compare_at_price | money }}</div>{%- endif -%}
        <div class="price" id="casaPriceNow">{{ variant.price | money }}</div>
        {%- if off_pct > 0 -%}<div class="off-pill">{{ off_pct }}% OFF</div>{%- endif -%}
      </div>

      {%- form 'product', product, id: form_id, class: 'casa-form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
        {%- else -%}
          <select name="id" id="casaVariantSelect" class="sticky-select" style="display:block;width:100%;margin-bottom:12px;padding:12px;" aria-label="Choose an option">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %} data-price="{{ v.price | money }}">{{ v.title }}{% unless v.available %} - Sold out{% endunless %}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        <input type="hidden" name="quantity" id="casaQtyInput" value="1">
        <div class="buy-row">
          <div class="qty-row">
            <button type="button" class="qty-btn js-qty-minus" aria-label="Decrease quantity">&minus;</button>
            <span class="qty-value js-qty-value">1</span>
            <button type="button" class="qty-btn js-qty-plus" aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="btn-addtocart" id="casaMainAdd"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add To Cart{% else %}Sold Out{% endif %}</button>
        </div>
      {%- endform -%}

      {%- if s.perk_text != blank -%}
        <div class="perks-row">
          <div class="perk"><span class="perk-icon">&#128666;</span> {{ s.perk_text }}</div>
        </div>
      {%- endif -%}

      <hr class="section-divider">

      <div class="desc-heading">Description</div>
      <div class="desc-text" id="pdpDesc">{{ pdp_desc }}</div>

      <div class="video-title">{{ s.reviews_title }}</div>
      <div class="video-row" id="reviewRow">
        {%- if review_blocks.size > 0 -%}
          {%- for block in review_blocks -%}
            {%- if block.settings.image != blank -%}
              <button type="button" class="video-card review-card" aria-label="Open customer review {{ forloop.index }}" {{ block.shopify_attributes }}><img src="{{ block.settings.image | image_url: width: 400 }}" data-full="{{ block.settings.image | image_url: width: 1000 }}" alt="Customer review {{ forloop.index }}" width="360" height="640" loading="lazy"></button>
            {%- else -%}
              <div class="video-card ph" {{ block.shopify_attributes }}><span class="bag">&#128717;</span><span class="play">&#9654;</span></div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif s.use_sample_reviews -%}
          {%- for n in (1..5) -%}
            {%- assign review_file = 'casa-review-' | append: n | append: '.jpg' -%}
            <button type="button" class="video-card review-card" aria-label="Open customer review {{ n }}"><img src="{{ review_file | asset_url }}" data-full="{{ review_file | asset_url }}" alt="Customer review {{ n }}" width="360" height="640" loading="lazy"></button>
          {%- endfor -%}
        {%- else -%}
          {%- for n in (1..5) -%}
            <div class="video-card ph"><span class="bag">&#128717;</span><span class="play">&#9654;</span></div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if s.discount_code != blank -%}
        <div class="discount-box">
          <span class="save-tag">SAVE</span>
          <span class="code-text">{{ s.discount_text }} <strong>{{ s.discount_code }}</strong></span>
          <button type="button" class="code-copy" id="copyCodeBtn" data-code="{{ s.discount_code | escape }}">Copy Code</button>
        </div>
      {%- endif -%}

      <div class="accordion">
        <div class="accordion-item open">
          <div class="accordion-head">Fast Shipping {%- if s.shipping_label != blank %} &mdash; <span class="learn-more" style="font-weight:400;">{{ s.shipping_label }}</span>{% endif %}<span class="plus">+</span></div>
          <div class="accordion-body">Order today for delivery by <strong id="deliveryDate" data-days="{{ s.delivery_days }}">within {{ s.delivery_days }} days</strong>.</div>
        </div>
        <div class="accordion-item">
          <div class="accordion-head">{{ s.guarantee_title }} <span class="plus">+</span></div>
          <div class="accordion-body">{{ s.guarantee_body }}</div>
        </div>
      </div>

      {%- if pair_p_final != blank and is_bundle == false -%}
        {%- assign pair_p = pair_p_final -%}
        {%- if s.pair_image != blank -%}
          {%- assign pair_img = s.pair_image | image_url: width: 300 -%}
        {%- else -%}
          {%- assign pair_img = pair_p.featured_image | image_url: width: 300 -%}
        {%- endif -%}
        <div id="pairSection">
          <div class="pair-title">Pair well with:</div>
          <div class="pair-card pair-single">
            <a class="pair-img" href="{{ pair_p.url }}" aria-label="View {{ pair_p.title | escape }}" style="display:block;background:#fff url('{{ pair_img }}') center/cover no-repeat;"></a>
            <div class="pair-info">
              <div class="name"><a href="{{ pair_p.url }}">{{ pair_p.title }}</a></div>
              <div class="p"><span class="was">{{ pair_p.selected_or_first_available_variant.price | money }}</span> {{ s.pair_now }}</div>
              {%- if s.pair_note != blank -%}<div class="pair-note">{{ s.pair_note }}</div>{%- endif -%}
              {%- if bundle_p != blank -%}<a class="quick" href="{{ bundle_p.url }}">Add to bundle</a>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </main>

  <!-- STICKY BOTTOM ADD-TO-CART BAR -->
  <div class="sticky-bar" id="stickyBar">
    {%- if product.featured_image != blank -%}
      <div class="sticky-thumb" style="background-image:url('{{ product.featured_image | image_url: width: 120 }}');background-size:cover;background-position:center;"></div>
    {%- endif -%}
    <div class="sticky-info">
      <div class="name">{{ product.title }}</div>
      <div class="price">{{ variant.price | money_with_currency }}</div>
    </div>
    {%- if bundle_p != blank or single_p != blank -%}
      <select class="sticky-select" id="stickyOptSelect" aria-label="Choose your set">
        {%- if is_bundle -%}
          {%- if single_p != blank -%}<option value="{{ single_p.url }}">{{ s.single_title }} &middot; {{ single_p.selected_or_first_available_variant.price | money }}</option>{%- endif -%}
          <option value="{{ product.url }}" selected>{{ s.bundle_title }} &middot; {{ variant.price | money }}</option>
        {%- else -%}
          <option value="{{ product.url }}" selected>{{ s.single_title }} &middot; {{ variant.price | money }}</option>
          {%- if bundle_p != blank -%}<option value="{{ bundle_p.url }}">{{ s.bundle_title }} &middot; {{ bundle_p.selected_or_first_available_variant.price | money }}</option>{%- endif -%}
        {%- endif -%}
      </select>
    {%- endif -%}
    <div class="sticky-qty">
      <button type="button" class="qty-btn js-qty-minus" aria-label="Decrease quantity">&minus;</button>
      <span class="qty-value js-qty-value">1</span>
      <button type="button" class="qty-btn js-qty-plus" aria-label="Increase quantity">+</button>
    </div>
    <button type="submit" form="{{ form_id }}" name="add" class="btn btn-cart"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add to Cart - {{ variant.price | money }}{% else %}Sold Out{% endif %}</button>
  </div>

  <div class="lb" id="reviewLb" role="dialog" aria-modal="true" aria-label="Customer review">
    <div class="lb-card">
      <img id="lbImg" alt="Customer review" width="540" height="960">
      <button type="button" class="lb-close" id="lbClose" aria-label="Close">&#10005;</button>
      <button type="button" class="lb-nav lb-prev" id="lbPrev" aria-label="Previous review">&#8249;</button>
      <button type="button" class="lb-nav lb-next" id="lbNext" aria-label="Next review">&#8250;</button>
    </div>
  </div>
</div>

<script src="{{ 'casa-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Casa product page",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Page type" },
    { "type": "select", "id": "mode", "label": "This page is for", "default": "single",
      "options": [ { "value": "single", "label": "A single product (warmer or cooler)" }, { "value": "bundle", "label": "The bundle product" } ] },
    { "type": "product", "id": "bundle_product", "label": "Override: Bundle product (leave empty — found automatically)" },
    { "type": "product", "id": "single_product", "label": "Override: Single product (leave empty — found automatically)" },

    { "type": "header", "content": "Top of page" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "rating_count", "label": "Review count (shown as stars + number; leave blank to hide)" },
    { "type": "text", "id": "perk_text", "label": "Perk line under Add To Cart", "default": "Free Shipping on orders £100+" },
    { "type": "textarea", "id": "description", "label": "Description (leave blank to use the product's own description)" },

    { "type": "header", "content": "Left option card (single product)" },
    { "type": "text", "id": "single_title", "label": "Title", "default": "Portable Warmer" },
    { "type": "text", "id": "single_sub", "label": "Sub-heading", "default": "Just the warmer" },
    { "type": "textarea", "id": "single_list", "label": "Tick list (one per line)" },
    { "type": "text", "id": "single_hint", "label": "Hint link text (single-product pages only)", "default": "Add the cooler & save 21% →" },

    { "type": "header", "content": "Cooler link card (bundle page only)" },
    { "type": "text", "id": "cooler_title", "label": "Title", "default": "Portable Cooler" },
    { "type": "text", "id": "cooler_sub", "label": "Sub-heading", "default": "Just the cooler" },
    { "type": "textarea", "id": "cooler_list", "label": "Tick list (one per line)" },

    { "type": "header", "content": "Bundle And Save card" },
    { "type": "text", "id": "bundle_title", "label": "Title", "default": "Bundle And Save" },
    { "type": "text", "id": "bundle_ribbon", "label": "Ribbon", "default": "BEST VALUE" },
    { "type": "text", "id": "bundle_badge", "label": "Save badge", "default": "SAVE 21%" },
    { "type": "text", "id": "bundle_sub", "label": "Sub-heading", "default": "Warmer & Cooler Set" },
    { "type": "textarea", "id": "bundle_list", "label": "Tick list (one per line)" },
    { "type": "text", "id": "gift_title", "label": "Strip heading", "default": "Your bundle" },
    { "type": "text", "id": "gift_name_1", "label": "Item 1 name", "default": "Warmer" },
    { "type": "image_picker", "id": "gift_image_1", "label": "Item 1 image (optional, default included)" },
    { "type": "text", "id": "gift_name_2", "label": "Item 2 name", "default": "Breast Milk Cooler" },
    { "type": "image_picker", "id": "gift_image_2", "label": "Item 2 image (optional, default included)" },
    { "type": "text", "id": "gift_name_3", "label": "Item 3 name", "default": "E-Book" },
    { "type": "image_picker", "id": "gift_image_3", "label": "Item 3 image (optional, default included)" },
    { "type": "text", "id": "gift_3_was", "label": "Item 3 crossed-out value (shows FREE below it; blank to hide)", "default": "£10" },

    { "type": "header", "content": "Reviews" },
    { "type": "text", "id": "reviews_title", "label": "Heading", "default": "What Other Parents Are Saying" },
    { "type": "checkbox", "id": "use_sample_reviews", "label": "Use the five built-in review photos (when no review blocks are added)", "default": false },

    { "type": "header", "content": "Discount box" },
    { "type": "text", "id": "discount_text", "label": "Text", "default": "20% with Code:" },
    { "type": "text", "id": "discount_code", "label": "Code (blank hides the box)" },

    { "type": "header", "content": "Shipping and guarantee" },
    { "type": "text", "id": "shipping_label", "label": "Shipping label", "default": "FREE OVER £100" },
    { "type": "range", "id": "delivery_days", "label": "Delivery estimate (days from today)", "min": 1, "max": 21, "step": 1, "default": 7 },
    { "type": "text", "id": "guarantee_title", "label": "Guarantee title", "default": "30 Days Guarantee" },
    { "type": "textarea", "id": "guarantee_body", "label": "Guarantee text", "default": "We stand behind our products. If you don't love it, exchanges and returns are available in 30 days." },

    { "type": "header", "content": "Pair well with" },
    { "type": "product", "id": "pair_product", "label": "Override: product to pair (leave empty — found automatically)" },
    { "type": "image_picker", "id": "pair_image", "label": "Image (optional, defaults to the product's first image)" },
    { "type": "text", "id": "pair_now", "label": "Bundle price text", "default": "£45.00 GBP" },
    { "type": "text", "id": "pair_note", "label": "Note", "default": "Bundle discount" }
  ],
